# One of these (or paste them in Settings)
#OPENAI_API_KEY=sk-...
#CODEX_API_KEY=
#OPENROUTER_API_KEY=sk-or-...  # open models (Kimi, DeepSeek, Qwen, GLM...) through OpenRouter

# Ollama: connect to Ollama Cloud (https://ollama.com/v1) or local Ollama (http://localhost:11434/v1)
#OLLAMA_API_KEY=
#OLLAMA_BASE_URL=http://localhost:11434/v1

# llama.cpp: connect to local or remote llama-server (default: http://localhost:8080/v1)
#LLAMACPP_BASE_URL=http://localhost:8080/v1
#LLAMACPP_API_KEY=

# Optional overrides
# DOTS_MODEL=gpt-5.5            # default: best available on your key
# DOTS_REVIEW_MODEL=gpt-5.4-mini
# DOTS_VOICE_MODEL=gpt-realtime-2.1
# "computer" = OpenAI computer-use tool driving the dot's browser; "off" = DOM browser tools only
DOTS_COMPUTER_TOOL=computer

# Computers: a cloud computer per dot with E2B, otherwise a Docker container, otherwise a sandbox folder
# E2B_API_KEY=e2b_...
#DOTS_COMPUTER=local           # force cloud | docker | local
DOTS_BOX_IMAGE=node:22-bookworm

# Triggers: the API key of a Composio project (platform.composio.dev)
#COMPOSIO_API_KEY=ck_...

# Where the app is served (Composio sign-in redirects back here)
DOTS_PUBLIC_URL=http://localhost:3100
